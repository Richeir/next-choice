# LLM 分析配置（OpenAI 兼容接口）
# 复制本文件为 .env 并填入真实值。缺少 LLM_API_KEY 时后端回退到纯技术面评分。

# OpenAI 兼容接口的 API Key（必填，否则不启用 LLM）
LLM_API_KEY=

# OpenAI 兼容接口的基础 URL（默认 https://api.openai.com/v1）
LLM_BASE_URL=https://api.openai.com/v1

# 使用的模型（可选；不填则用 analysis.config.json 的 model）
LLM_MODEL=gpt-4o

# 雪球 xq_a_token（采集脚本 scripts/ 用，见 issue #55）
# akshare 内置 token 已过期（error 400016），不配置则 --fetch-stock-info /
# --fetch-etf-info 的雪球调用全部失败。获取：浏览器登录 xueqiu.com 后，
# 从 DevTools -> Application -> Cookies 拷贝 xq_a_token 的值。
# 注意：Python 脚本不自动加载 .env，运行前需 export XQ_TOKEN=<拷贝的值>。
XQ_TOKEN=
